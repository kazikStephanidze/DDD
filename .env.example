# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL where the app is hosted (e.g. https://your-app.vercel.app)
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather (set this in Vercel Environment Variables!)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# BOT_TIMEZONE: IANA timezone for 12:00 daily horoscope, 12:01 leaderboard, 20:55 lottery, 21:00 summary
BOT_TIMEZONE="Europe/Minsk"

# FIREBASE_DATABASE_URL: Firebase Realtime Database URL
FIREBASE_DATABASE_URL="https://dyadyadep-4ead0-default-rtdb.europe-west1.firebasedatabase.app"

# FIREBASE_DATABASE_SECRET: Optional legacy DB secret (only needed if RTDB rules restrict unauthenticated reads/writes)
FIREBASE_DATABASE_SECRET=""

# CRON_SECRET: Optional secret token to protect /api/cron when called by external cron services
CRON_SECRET=""
